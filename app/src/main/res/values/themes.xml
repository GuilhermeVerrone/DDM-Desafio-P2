<resources>
    <!-- Barras do sistema ficam transparentes (edge-to-edge); o cabeçalho escuro passa por trás da status bar. -->
    <style name="Base.Theme.MinhaLoja" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondaryContainer">@color/brand_soft</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark</item>
        <item name="colorError">@color/danger</item>
        <item name="android:windowBackground">@color/surface_bg</item>
    </style>

    <style name="Theme.MinhaLoja" parent="Base.Theme.MinhaLoja" />
</resources>
